# Copy to .env (repo root). The backend reads ./.env and ../.env.

# --- LLM: "ollama" for free local dev, "google" (Google AI Studio Gemini API) for production
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL=llama3.2
GOOGLE_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3-flash-preview   # free tier documented; gemini-3.8-flash is stronger but check its pricing

# --- Search: Tavily free tier (1,000 searches/month). Leave empty to use DuckDuckGo only.
TAVILY_API_KEY=

# --- Budget
MAX_SUB_QUESTIONS=4
MAX_REVISIONS=2
# RUN_DEADLINE_S defaults to 270 on Vercel and 1200 locally

# --- Storage: SQLite locally; Vercel Marketplace Neon sets DATABASE_URL automatically
DATABASE_URL=sqlite+aiosqlite:///./deep_synth.db
CORS_ORIGINS=http://localhost:3000
# Read client IPs from X-Real-IP/X-Forwarded-For only behind a proxy that overwrites them.
# Defaults to true on Vercel, false elsewhere.
# TRUST_PROXY_HEADERS=false

# --- Tracing: local Phoenix (docker compose up phoenix) or Phoenix Cloud
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
