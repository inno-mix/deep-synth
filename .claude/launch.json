{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && pnpm build && pnpm start -p 3001"
      ],
      "port": 3001
    }
  ]
}
